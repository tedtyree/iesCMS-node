// website-secrets-SAMPLE.jfx
// This documents the per-site secrets feature (see iesCMS-node PRD.md #REQ-SECRETS-01 and
// CLAUDE.md's "Per-Site Secrets (cms.SECRETS)" section).
//
// To adopt this for a website:
//   1) Copy this file to: websites/<yourSiteId>/secrets/secrets.jfx
//      (structure it however your site needs — this is just an example shape)
//   2) Fill in real values.
//   3) Add to that website's OWN .gitignore (each website is normally its own git repo):
//        /secrets/*
//        !/secrets/.gitkeep
//   4) Commit an empty websites/<yourSiteId>/secrets/.gitkeep so the folder exists in git.
//   5) Commit a copy of this file as websites/<yourSiteId>/secrets-example.jfx (placeholder
//      values only) so other developers on the site know what to fill in.
//
// secrets.jfx is loaded ONCE at server startup (not re-read per request like site.cfg) into
// cms.SECRETS. It is NEVER part of the [[tag]] replacement chain (HEADER -> SITE -> SERVER) —
// read it explicitly in code, e.g.:
//
//   const apiKey = cms.SECRETS.getStr('someProvider.apiKey', '');
//
// See websites/chatbot/secrets-example.jfx for a real, working example.
{
    someProvider: {
        apiKey: "your-api-key-here"
    }

    ,anotherProvider: {
        apiKey: "your-other-api-key-here"
        ,apiSecret: "your-other-api-secret-here"
    }
}
